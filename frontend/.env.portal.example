# LIVE PORTAL frontend build (on the server only).
#   cp .env.portal.example .env.production   then   npm run build
# NEXT_PUBLIC_* values are baked in at BUILD time: change it -> rebuild.
# Never create .env.production on the Windows build PC: the EXE would then call the portal instead of its local server.
NEXT_PUBLIC_API_BASE_URL=https://iapp.vcglobalskills.in/api
