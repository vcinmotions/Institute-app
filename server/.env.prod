DB_PROVIDER=sqlite

CENTRAL_DATABASE_URL=file:C:/Users/Administrator/AppData/Roaming/vcinmotions-appliance/central.db
TENANT_DATABASE_URL=file:C:/Users/Administrator/AppData/Roaming/vcinmotions-appliance/tenant.db

APP_ENV=prod


RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=any-long-random-string-you-choose


# ---- Subscription (EXE verifies with the PUBLIC key; only the portal holds the private key) ----
SUBSCRIPTION_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQXhhYng5Q0RtbmdPM0RzWUtQNnFrcEZPaUpQdHk5VkQwQzcwMndPTko1aXc9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo=
SUBSCRIPTION_SYNC_MINUTES=5
SUBSCRIPTION_API_URL=https://iapp.vcglobalskills.in
SUBSCRIPTION_PORTAL_URL=https://iapp.vcglobalskills.in

# ---- Free trial + login seats ----
# Length of the free trial offered to new customers at registration (web portal server).
TRIAL_MONTHS=1
# A login seat is freed when the app sends no heartbeat for this many seconds
# (crash, power cut, network loss). The app sends one every 60 seconds.
SESSION_TIMEOUT_SECONDS=180
# Local mode only (SUBSCRIPTION_MODE is not ENABLED): months the app is valid from its first run, then view-only until renewed. Default 6.
LOCAL_LICENSE_MONTHS=6

# ---- Server (the desktop app sets PORT / HOST itself; these are used when you run the server on its own) ----
# Backend port
PORT=5001
# Address to listen on. 0.0.0.0 = reachable from the LAN
HOST=127.0.0.1
# Public address of this server (used in links such as certificates)
SERVER_URL=http://localhost:5001
# error | warn | info | debug
LOG_LEVEL=info
# Used by src/config for token lifetime
JWT_EXPIRES_IN=24h
# Max upload size in bytes (10 MB)
MAX_FILE_SIZE=10485760

# ---- Set automatically by the desktop app - do not set here ----
# Set by the desktop app
# NODE_ENV=production
# Folder holding the databases (set by the desktop app)
# USER_DATA_PATH=
# Install folder of the app (set by the desktop app)
# RESOURCES_PATH=
# Installed version (set by the desktop app)
# APP_VERSION=

# ---- Licence mode  (ENABLED = Server/Client keys + portal subscription; anything else = local mode, no keys) ----
# ENABLED or STANDALONE. In an installed app this is fixed at BUILD time and signed
#SUBSCRIPTION_MODE=STANDALONE
SUBSCRIPTION_MODE=ENABLED
# off = skip the file-timestamp clock-rollback check
SUBSCRIPTION_FILE_CLOCK_CHECK=on

# ---- Database ----
# PostgreSQL user (development / portal only)
DB_USER=postgres
# PostgreSQL host (development / portal only)
DB_HOST=localhost
# PostgreSQL port (development / portal only)
DB_PORT=5432
# PostgreSQL password. Put the real value in .env, not in a committed file
# DB_PASS=
# Host used when the portal creates a new institute database
PG_HOST=localhost
# Port for the same
PG_PORT=5432
# User for the same
PG_USER=postgres
# Password for the same. Put the real value in .env
# PG_PASSWORD=
# Only used by the old setup script (utils/setupInstitute.ts)
# DATABASE_URL=
# Only used by the old migrate script (scripts/migrate-all-tenants.ts)
# CLIENT_DATABASE_URL=

# ---- Redis (optional, not required) ----
# Only if you use Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- Secrets - keep the real values in server/.env (not committed). Never commit them in this file ----
# Signs login tokens
# JWT_SECRET=
# Encrypts backups. Losing it makes old backups unreadable
# BACKUP_SECRET=
# Encrypts stored passwords
# ENCRYPTION_KEY=

# ---- Portal only (hosted server) - SUBSCRIPTION_PRIVATE_KEY lives in .env.portal, never in the installer ----
# In .env.portal only
# SUBSCRIPTION_PRIVATE_KEY=
