generator client {
  provider = "prisma-client-js"
  output   = "../../prisma-client/generated/tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientAdmin {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  instituteName       String
  slug                String               @unique
  fullAddress         String
  logo                String?
  certificateName     String?
  stamp               String?
  sign                String?
  contact             String
  position            String
  country             String
  state               String
  city                String
  zipCode             String
  createdAt           DateTime             @default(now())
  role                UserRole             @default(ADMIN)
  currentSessionToken String?
  lastLoginAt         DateTime?
  activities          ActivityLog[]
  attendanceRecords   AttendanceRecord[]
  batches             Batch[]
  certificates        Certificate[]
  courses             Course[]
  courseCompletions   CourseCompletion[]
  courseFeeStructures CourseFeeStructure[]
  enquiries           Enquiry[]            @relation("AdminToEnquiries")
  enquiryCourse       EnquiryCourse[]
  faculties           Faculty[]
  feeStructures       FeeStructure[]
  financialRecords    FinancialRecord[]
  financialYears      FinancialYear[]
  labs                Lab[]
  labAllocations      LabAllocation[]
  labTimeSlots        LabTimeSlot[]
  notifications       Notification[]
  roleUsers           RoleUser[]
  stationeryIssues    StationeryIssue[]
  StationeryItems     StationeryItem[]
  students            Student[]
  studentCourses      StudentCourse[]
  studentFees         StudentFee[]
  studentTasks        StudentTask[]
  studentTests        StudentTest[]
  tasks               Task[]
  tests               Test[]
}

model FinancialYear {
  id            String      @id @default(uuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean     @default(false)
  clientAdminId String
  createdAt     DateTime    @default(now())
  clientAdmin   ClientAdmin @relation(fields: [clientAdminId], references: [id])

  @@unique([clientAdminId, name])
}

model RoleUser {
  id                  String      @id @default(uuid())
  name                String
  email               String      @unique
  password            String
  role                UserRole
  createdAt           DateTime    @default(now())
  country             String
  state               String
  city                String
  zipCode             String
  currentSessionToken String?
  lastLoginAt         DateTime?
  clientAdminId       String
  clientAdmin         ClientAdmin @relation(fields: [clientAdminId], references: [id])
}

model ActivityLog {
  id            String      @id @default(uuid())
  entity        String
  entityId      String
  action        String
  message       String?
  createdAt     DateTime    @default(now())
  clientAdminId String
  clientAdmin   ClientAdmin @relation(fields: [clientAdminId], references: [id])
}

model Enquiry {
  id               String          @id @default(uuid())
  srNo             Int             @unique
  name             String
  contact          String
  alternateContact String?
  email            String?
  age              Int?
  location         String?
  city             String?
  course           String?
  gender           String?
  dob              DateTime?

  sourceId         Int?
  source           SourceType?     @relation(fields: [sourceId], references: [id])

  referedBy        String?
  takenBy          String?
  leadStatus       LeadStatus      @default(WARM)
  enquiryDate      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isConverted      Boolean         @default(false)
  studentId        Int?            @unique
  clientAdminId    String
  clientAdmin      ClientAdmin     @relation("AdminToEnquiries", fields: [clientAdminId], references: [id])
  student          Student?        @relation("EnquiryToStudent", fields: [studentId], references: [id])
  enquiryCourse    EnquiryCourse[]
  followUps        FollowUp[]
  notification     Notification?

  @@unique([email, clientAdminId])
  @@unique([contact, clientAdminId])
}

model SourceType {
  id           Int         @id @default(autoincrement())
  name         String      
  slug         String      @unique

  createdAt      DateTime       @default(now())

  enquiries Enquiry[]
}

model EnquiryCourse {
  id            Int         @id @default(autoincrement())
  enquiryId     String
  courseId      Int
  clientAdminId String
  clientAdmin   ClientAdmin @relation(fields: [clientAdminId], references: [id])
  course        Course      @relation(fields: [courseId], references: [id])
  enquiry       Enquiry     @relation(fields: [enquiryId], references: [id])

  @@unique([enquiryId, courseId])
}

model FollowUp {
  id             String         @id @default(uuid())
  enquiryId      String
  scheduledAt    DateTime?
  doneAt         DateTime?
  remark         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  followUpStatus FollowUpStatus @default(PENDING)
  enquiry        Enquiry        @relation(fields: [enquiryId], references: [id])
  notification   Notification?
}

model Notification {
  id            String      @id @default(uuid())
  message       String
  seen          Boolean     @default(false)
  createdAt     DateTime    @default(now())
  followUpId    String?     @unique
  enquiryId     String?     @unique
  paymentId     Int?        @unique
  clientAdminId String
  clientAdmin   ClientAdmin @relation(fields: [clientAdminId], references: [id])
  enquiry       Enquiry?    @relation(fields: [enquiryId], references: [id])
  followUp      FollowUp?   @relation(fields: [followUpId], references: [id])
  payment       StudentFee? @relation(fields: [paymentId], references: [id])
}

model AdmissionNumberConfig {
  id            String @id @default(uuid())
  clientAdminId String @unique

  prefix        String?   // ABI
  suffix        String?   // 2627
  separator     String @default("-") // -

  currentNumber Int
  numberLength  Int @default(4)

  createdAt     DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PaymentReceiptConfig {
  id            String @id @default(uuid())
  clientAdminId String @unique

  prefix        String?   // RCP
  suffix        String?   // 2627
  separator     String @default("-") // -

  currentNumber Int
  numberLength  Int @default(4)

  createdAt     DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Student {
  id                 Int                @id @default(autoincrement())
  serialNumber       Int                @unique
  studentCode        String             @unique
  admissionNumber    String             @unique
  fullName           String
  fatherName         String?
  photoUrl           String?
  contact            String
  parentsContact     String?
  email              String?
  residentialAddress String?
  permenantAddress   String?
  dob                DateTime?
  gender             String?
  religion           String?
  idProofType                 String?
  idProofNumber               String?
  localAddressProofType       String?
  localAddressProofNumber     String?
  referedBy                   String?
  idCard                      Boolean @default(false)
  bag                         Boolean @default(false)
  admissionDate      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  clientAdminId      String
  qualification      String?
  attendance         AttendanceRecord[]
  certificates       Certificate[]
  completions        CourseCompletion[]
  enquiry            Enquiry?           @relation("EnquiryToStudent")
  feeStructures      FeeStructure[]
  financialRecords   FinancialRecord[]
  labAllocations     LabAllocation[]
  stationery         StationeryIssue[]
  clientAdmin        ClientAdmin        @relation(fields: [clientAdminId], references: [id])
  studentCourses     StudentCourse[]
  feeRecords         StudentFee[]
  tasks              StudentTask[]
  tests              StudentTest[]
}

model Course {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  clientAdminId      String
  durationMonths     Int?
  attendanceRecords  AttendanceRecord[]
  batchCourses       BatchCourse[]
  certificates       Certificate[]
  clientAdmin        ClientAdmin         @relation(fields: [clientAdminId], references: [id])
  courseFeeStructure CourseFeeStructure?
  enquiryCourse      EnquiryCourse[]
  feeStructures      FeeStructure[]
  financialRecords   FinancialRecord[]
  stationery         StationeryIssue[]
  studentCourses     StudentCourse[]
  studentFees        StudentFee[]
  studentTasks       StudentTask[]
  studentTests       StudentTest[]
  tasks              Task[]
  tests              Test[]
}

model CourseFeeStructure {
  id            Int                 @id @default(autoincrement())
  courseId      Int                 @unique
  totalAmount   Float
  paymentType   String[]
  clientAdminId String
  clientAdmin   ClientAdmin         @relation(fields: [clientAdminId], references: [id])
  course        Course              @relation(fields: [courseId], references: [id])
  installments  InstallmentDetail[]
}

model Batch {
  id             Int             @id @default(autoincrement())
  name           String
  facultyId      Int?
  labTimeSlotId  Int
  clientAdminId  String
  clientAdmin    ClientAdmin     @relation(fields: [clientAdminId], references: [id])
  faculty        Faculty?        @relation(fields: [facultyId], references: [id])
  labTimeSlot    LabTimeSlot     @relation(fields: [labTimeSlotId], references: [id])
  batchCourses   BatchCourse[]
  studentCourses StudentCourse[]
  tasks          Task[]
  tests          Test[]

  @@unique([labTimeSlotId, clientAdminId])
}

model BatchCourse {
  id          Int    @id @default(autoincrement())
  batchId     Int
  courseId    Int
  pcsReserved Int?   @default(0)
  batch       Batch  @relation(fields: [batchId], references: [id])
  course      Course @relation(fields: [courseId], references: [id])

  @@unique([batchId, courseId])
}

model Faculty {
  id                  Int                @id @default(autoincrement())
  name                String
  email               String             @unique
  password            String
  contact             String
  joiningDate         DateTime
  specialization      String?
  role                UserRole           @default(FACULTY)
  country             String
  state               String
  city                String
  zipCode             String
  currentSessionToken String?
  lastLoginAt         DateTime?
  clientAdminId       String
  attendance          AttendanceRecord[]
  batches             Batch[]
  clientAdmin         ClientAdmin        @relation(fields: [clientAdminId], references: [id])
  financialRecords    FinancialRecord[]
  tasks               StudentTask[]      @relation("FacultyTasks")
}

model Lab {
  id               Int               @id @default(autoincrement())
  name             String
  location         String?
  totalPCs         Int
  isActive         Boolean           @default(true)
  clientAdminId    String
  financialRecords FinancialRecord[]
  clientAdmin      ClientAdmin       @relation(fields: [clientAdminId], references: [id])
  timeSlots        LabTimeSlot[]
}

model LabTimeSlot {
  id            Int             @id @default(autoincrement())
  startTime     String
  endTime       String
  day           String
  labId         Int
  availablePCs  Int
  clientAdminId String
  batches       Batch[]
  allocations   LabAllocation[]
  clientAdmin   ClientAdmin     @relation(fields: [clientAdminId], references: [id])
  lab           Lab             @relation(fields: [labId], references: [id])
}

model PaymentStructureType {
  id               Int         @id @default(autoincrement())
  name             PaymentType
  installmentCount Int?
}

model InstallmentDetail {
  id                   Int                @id @default(autoincrement())
  CourseFeeStructureId Int
  number               Int
  amount               Float
  feeStructures        FeeStructure[]
  CourseFeeStructure   CourseFeeStructure @relation(fields: [CourseFeeStructureId], references: [id])
}

model LabAllocation {
  id            Int         @id @default(autoincrement())
  labTimeSlotId Int
  studentId     Int
  pcNumber      Int
  assignedAt    DateTime    @default(now())
  clientAdminId String
  clientAdmin   ClientAdmin @relation(fields: [clientAdminId], references: [id])
  labTimeSlot   LabTimeSlot @relation(fields: [labTimeSlotId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])

  @@unique([labTimeSlotId, pcNumber])
  @@unique([labTimeSlotId, studentId])
}

model StudentCourse {
  id            Int                @id @default(autoincrement())
  studentId     Int
  courseId      Int
  startDate     DateTime
  endDate       DateTime
  studentCode   String
  batchId       Int?
  internalNotes String?
  status        String
  clientAdminId String
  certificate   Certificate?
  completions   CourseCompletion[]
  batch         Batch?             @relation(fields: [batchId], references: [id])
  clientAdmin   ClientAdmin        @relation(fields: [clientAdminId], references: [id])
  course        Course             @relation(fields: [courseId], references: [id])
  student       Student            @relation(fields: [studentId], references: [id])
}

model FeeStructure {
  id                Int                @id @default(autoincrement())
  studentId         Int
  courseId          Int
  totalAmount       Float
  paymentType       PaymentType
  installmentCount  Int?
  installmentTypeId Int?
  clientAdminId     String
  clientAdmin       ClientAdmin        @relation(fields: [clientAdminId], references: [id])
  course            Course             @relation(fields: [courseId], references: [id])
  installment       InstallmentDetail? @relation(fields: [installmentTypeId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model StudentFeeLog {
  id           Int         @id @default(autoincrement())
  studentFeeId Int
  amountPaid   Float
  paymentDate  DateTime
  paymentMode  PaymentMode
  receiptNo    String      @unique
  studentFee   StudentFee  @relation(fields: [studentFeeId], references: [id])
}

model StudentFee {
  id               Int             @id @default(autoincrement())
  studentId        Int
  courseId         Int?
  dueDate          DateTime
  amountDue        Float
  amountPaid       Float           @default(0)
  paymentDate      DateTime?
  createdAt        DateTime        @default(now())
  paymentMode      PaymentMode?
  receiptNo        String?
  paymentStatus    PaymentStatus   @default(PENDING)
  isOpeningBalance Boolean         @default(false)
  sourceType       String?
  clientAdminId    String
  notification     Notification?
  clientAdmin      ClientAdmin     @relation(fields: [clientAdminId], references: [id])
  course           Course?         @relation(fields: [courseId], references: [id])
  student          Student         @relation(fields: [studentId], references: [id])
  feeLogs          StudentFeeLog[]
}

model StationeryItem {
  id                Int               @id @default(autoincrement())
  name              String
  totalQuantity     Int
  quantityAvailable Int
  clientAdminId     String
  stationeryIssues  StationeryIssue[]
  clientAdmin       ClientAdmin       @relation(fields: [clientAdminId], references: [id])
}

model StationeryIssue {
  id            Int            @id @default(autoincrement())
  studentId     Int
  courseId      Int
  itemId        Int
  issueDate     DateTime
  quantity      Int
  remarks       String?
  clientAdminId String
  clientAdmin   ClientAdmin    @relation(fields: [clientAdminId], references: [id])
  course        Course         @relation(fields: [courseId], references: [id])
  item          StationeryItem @relation(fields: [itemId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
}

model AttendanceRecord {
  id            Int         @id @default(autoincrement())
  studentId     Int
  courseId      Int
  date          DateTime
  present       Boolean
  facultyId     Int
  batchId       Int?
  clientAdminId String
  clientAdmin   ClientAdmin @relation(fields: [clientAdminId], references: [id])
  course        Course      @relation(fields: [courseId], references: [id])
  markedBy      Faculty     @relation(fields: [facultyId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])
}

model Task {
  id            Int           @id @default(autoincrement())
  name          String
  status        TaskStatus    @default(DRAFT)
  batchId       Int
  courseId      Int
  clientAdminId String
  StudentTask   StudentTask[]
  batch         Batch         @relation(fields: [batchId], references: [id])
  clientAdmin   ClientAdmin   @relation(fields: [clientAdminId], references: [id])
  course        Course        @relation(fields: [courseId], references: [id])
}

model StudentTask {
  id             Int         @id @default(autoincrement())
  studentId      Int
  courseId       Int
  assignedDate   DateTime
  dueDate        DateTime
  description    String
  status         String
  facultyRemarks String?
  grade          String?
  taskId         Int
  facultyId      Int?
  clientAdminId  String
  clientAdmin    ClientAdmin @relation(fields: [clientAdminId], references: [id])
  course         Course      @relation(fields: [courseId], references: [id])
  faculty        Faculty?    @relation("FacultyTasks", fields: [facultyId], references: [id])
  student        Student     @relation(fields: [studentId], references: [id])
  task           Task        @relation(fields: [taskId], references: [id])
}

model Test {
  id            Int           @id @default(autoincrement())
  name          String
  status        TestStatus    @default(DRAFT)
  batchId       Int
  courseId      Int
  clientAdminId String
  StudentTest   StudentTest[]
  batch         Batch         @relation(fields: [batchId], references: [id])
  clientAdmin   ClientAdmin   @relation(fields: [clientAdminId], references: [id])
  course        Course        @relation(fields: [courseId], references: [id])
}

model StudentTest {
  id            Int         @id @default(autoincrement())
  studentId     Int
  courseId      Int
  testName      String
  testDate      DateTime
  assignedDate  DateTime
  description   String
  status        String
  totalMarks    Int?
  marksObtained Int?
  grade         String?
  testId        Int
  clientAdminId String
  clientAdmin   ClientAdmin @relation(fields: [clientAdminId], references: [id])
  course        Course      @relation(fields: [courseId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])
  test          Test        @relation(fields: [testId], references: [id])
}

model CourseCompletion {
  id              Int           @id @default(autoincrement())
  studentCourseId Int
  studentId       Int
  completionDate  DateTime
  feedback        String?
  remarks         String?
  clientAdminId   String
  clientAdmin     ClientAdmin   @relation(fields: [clientAdminId], references: [id])
  studentCourse   StudentCourse @relation(fields: [studentCourseId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
}

model Certificate {
  id              Int           @id @default(autoincrement())
  studentId       Int
  courseId        Int
  studentCourseId Int           @unique
  issueDate       DateTime
  certificateUrl  String
  clientAdminId   String
  clientAdmin     ClientAdmin   @relation(fields: [clientAdminId], references: [id])
  course          Course        @relation(fields: [courseId], references: [id])
  studentCourse   StudentCourse @relation(fields: [studentCourseId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
}

model FinancialRecord {
  id            String       @id @default(cuid())
  clientAdminId String
  recordType    RecordType
  amount        Float
  description   String?
  date          DateTime     @default(now())
  paymentMode   PaymentMode?
  studentId     Int?
  courseId      Int?
  facultyId     Int?
  labId         Int?
  clientAdmin   ClientAdmin  @relation(fields: [clientAdminId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])
  faculty       Faculty?     @relation(fields: [facultyId], references: [id])
  lab           Lab?         @relation(fields: [labId], references: [id])
  student       Student?     @relation(fields: [studentId], references: [id])
}

enum RecordType {
  INCOME
  EXPENSE
}

enum LeadStatus {
  COLD
  WARM
  HOT
  WON
  LOST
  HOLD
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentType {
  ONE_TIME
  INSTALLMENT
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum UserRole {
  ADMIN
  FRONT_DESK
  FACULTY
  ACCOUNTANT
  VIEW_ONLY
}

enum TestStatus {
  DRAFT
  PUBLISHED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
}
