# =====================================================================
#  LIVE PORTAL SERVER  (https://iapp.vcglobalskills.in)
#
#  On the server:  cp .env.portal.example .env.portal   then replace every CHANGE_ME.
#  This template has no secrets and is safe to commit. The real .env.portal is git-ignored.
#
#  Start the server with APP_ENV=portal (set it in the pm2 start command, not in this file:
#  it must be set before this file is read). Then only this file and server/.env are loaded;
#  .env.dev / .env.prod from git are never read.
#  Never use APP_ENV=prod on the server: that is the desktop EXE (SQLite + SQLite migrations).
#  The server also creates server/.env by itself and appends one
#  "<institute>_CLIENT_DATABASE_URL" line per new institute: keep that file and back it up.
# =====================================================================

# ---- Runtime ----
NODE_ENV=production
PORT=5001
# 127.0.0.1 = only nginx can reach the API (ports 5001/3000 stay closed in the firewall)
HOST=127.0.0.1
SERVER_URL=https://iapp.vcglobalskills.in
# Public sites allowed to call the API / open a socket (comma-separated host names or full origins).
# localhost and LAN addresses are always allowed.
CORS_ALLOWED_ORIGINS=iapp.vcglobalskills.in
LOG_LEVEL=info
JWT_EXPIRES_IN=24h
# 10 MB. Keep nginx client_max_body_size above this.
MAX_FILE_SIZE=10485760

# ---- Database (PostgreSQL on this server) ----
DB_PROVIDER=postgres
DB_USER=iapp
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432
CENTRAL_DATABASE_URL=postgresql://iapp:CHANGE_ME_DB_PASSWORD@localhost:5432/iapp_central
# Required at startup by src/config. Used as the template tenant database.
TENANT_DATABASE_URL=postgresql://iapp:CHANGE_ME_DB_PASSWORD@localhost:5432/tenant

# Used when the portal creates a new database for each institute (user needs CREATEDB).
# PG_PASSWORD MUST be set: if it is missing the code falls back to a hard-coded development password.
PG_USER=iapp
PG_PASSWORD=CHANGE_ME_DB_PASSWORD
PG_HOST=localhost
PG_PORT=5432
# Database the app connects to when it runs CREATE DATABASE for a new institute.
# cPanel users cannot open "postgres", so use your central database. The user also needs CREATEDB.
PG_ADMIN_DATABASE=vcglobal_iapp

# ---- Secrets: generate NEW values on the server (openssl rand -hex 32). Never reuse dev values. ----
# Signs login tokens. Changing it later logs everyone out.
JWT_SECRET=CHANGE_ME
# Encrypts stored passwords. Changing it later makes stored values unreadable.
ENCRYPTION_KEY=CHANGE_ME
# Encrypts backups. Losing it makes old backups unreadable.
BACKUP_SECRET=CHANGE_ME

# ---- Subscription / licensing ----
# PRIVATE key: lives ONLY here on the portal server and on the build PC. Never in the EXE or git.
# It must pair with the public key compiled into src/config/licensePublicKey.ts,
# otherwise every installed EXE rejects its licence. Copy it from your local server/.env.portal.
SUBSCRIPTION_PRIVATE_KEY=CHANGE_ME
# Public half of the same key pair (copy from your local server/.env).
SUBSCRIPTION_PUBLIC_KEY=CHANGE_ME
SUBSCRIPTION_API_URL=https://iapp.vcglobalskills.in
SUBSCRIPTION_PORTAL_URL=https://iapp.vcglobalskills.in
SUBSCRIPTION_MODE=ENABLED
SUBSCRIPTION_SYNC_MINUTES=180
# Free trial offered at sign-up (months)
TRIAL_MONTHS=1
# A login seat is freed when no heartbeat arrives for this many seconds
SESSION_TIMEOUT_SECONDS=180

# ---- Razorpay: LIVE keys (Dashboard > Live mode > API Keys / Webhooks) ----
# Webhook URL: https://iapp.vcglobalskills.in/api/portal/razorpay-webhook
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ---- Redis (optional; leave commented if not installed) ----
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- Desktop-EXE only: do not set on the portal server ----
# USER_DATA_PATH, RESOURCES_PATH, APP_VERSION, LOCAL_LICENSE_MONTHS, SUBSCRIPTION_FILE_CLOCK_CHECK
